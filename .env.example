# Application
APP_NAME=voice-agent-demo
LOG_LEVEL=INFO

# Optional: ElevenLabs Text-to-Speech (server-side only; use with POST {"synthesize_speech": true})
# Create an API key under Profile / API keys: https://elevenlabs.io/app/settings/api-keys
# Pick a voice_id from Voices in the app or via GET https://api.elevenlabs.io/v1/voices
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Optional: request correlation / tracing (enterprise adapters)
# TRACE_HEADER_NAME=x-request-id
